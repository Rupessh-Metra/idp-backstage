# Copy to deploy/.env and fill in real values. Never commit the real .env.

# Public URL the app is served at (used for app.baseUrl, backend.baseUrl,
# backend.cors.origin, and the GitHub OAuth callback URL).
APP_BASE_URL=https://idp.example.com

# Postgres connection. POSTGRES_HOST should be the docker-compose service
# name ("postgres") unless you're pointing at an external database.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=backstage
POSTGRES_PASSWORD=changeme
# Only consumed by the postgres:16 image itself on first boot (to create its
# default database) - Backstage creates its own per-plugin databases once
# connected and doesn't read this var directly.
POSTGRES_DB=backstage

# GitHub integration token (repo scope) used for catalog discovery, the
# TechDocs source, and the github:repo:grant/revoke scaffolder actions.
GITHUB_TOKEN=

# GitHub OAuth App used for user sign-in. Callback URL must be
# ${APP_BASE_URL}/api/auth/github/handler/frame.
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=

# Kubeconfig file paths as seen INSIDE the container - must match the mount
# targets in deploy/docker-compose.yml (/app/kubeconfig.yaml and
# /app/deploy-kubeconfig.yaml). Put the actual files at
# deploy/secrets/kubeconfig.yaml and deploy/secrets/deploy-kubeconfig.yaml
# on the server.
KUBECONFIG_PATH=/app/kubeconfig.yaml
DEPLOY_KUBECONFIG_PATH=/app/deploy-kubeconfig.yaml

# Docker Hub credentials used by the kubernetes:deploy scaffolder action to
# resolve the latest pushed image tag, plus the name of the imagePullSecret
# already created in the target cluster/namespace.
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=
DOCKERHUB_IMAGE_PULL_SECRET=dockerhub-cred
